<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Debug-only screens. None has a launcher icon, so the phone shows a single app; start one
          with: adb shell am start -n com.qtekfun.ultimatemail/<activity name below>
        -->
        <activity
            android:name=".ui.debug.OAuthDebugActivity"
            android:exported="true"
            android:label="@string/oauth_debug_label">
        </activity>

        <!--
          Debug builds only: shows built-in sample messages in the safe HTML view. It ignores
          every extra, so being exported (to start it from adb) exposes nothing.
        -->
        <activity
            android:name=".ui.html.SafeHtmlDebugActivity"
            android:exported="true"
            android:label="@string/debug_safe_html_title">
        </activity>

        <!--
          Debug builds only: inserts or removes made-up demo accounts (reserved .invalid domain).
          It never touches other accounts, so being exported (to start it from adb) is harmless.
        -->
        <activity
            android:name=".ui.debug.InboxDemoActivity"
            android:exported="true"
            android:label="@string/debug_demo_label">
        </activity>

        <!--
          Debug builds only: the move / label picker over made-up demo accounts (reserved .invalid
          domain). It lists only those accounts, so being exported (to start it from adb) is harmless.
        -->
        <activity
            android:name=".ui.debug.PickerDemoActivity"
            android:exported="true"
            android:label="@string/debug_picker_label" />
    </application>

</manifest>
